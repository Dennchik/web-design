         article.case-card
            .case-card__image-wrapper
               img.case-card__image(src="img/case-1.png", alt="Интерьеры со смыслом")
            .case-card__info
               h3.case-card__title Сайт для студии
               .case-card__tags
                  span.tag.tag--accent +34% заявок
                  span.tag Запуск за 10 дней
         article.case-card
            .case-card__image-wrapper
               img.case-card__image(src="img/case-2.png", alt="Массаж, который возвращает лёгкость")
            .case-card__info
               h3.case-card__title Лендинг для услуги
               .case-card__tags
                  span.tag.tag--accent +27% конверсия
                  span.tag Запуск за 7 дней
         article.case-card
            .case-card__image-wrapper
               img.case-card__image(src="img/case-3.png", alt="Контент-пакет для бренда")
            .case-card__info
               h3.case-card__title Контент-пакет для бренда
               .case-card__tags
                  span.tag 10 рилсов
                  span.tag Съёмка и монтаж